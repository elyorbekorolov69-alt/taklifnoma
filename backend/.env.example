# Bu faylni ".env" nomi bilan nusxalang va to'ldiring. .env GitHub'ga YUBORILMAYDI.

# Taklifnoma yaratish/o'zgartirish uchun maxfiy kalit (uzun, tasodifiy so'z o'ylab toping)
ADMIN_KEY=

# Sayt (frontend) manzili: faqat shu manzildan so'rovlar qabul qilinadi
# Masalan: https://FOYDALANUVCHI.github.io
FRONTEND_URL=*

# Baza (Supabase). Bo'sh qoldirsangiz, ma'lumot data.json fayliga yoziladi (faqat sinov uchun)
SUPABASE_URL=
SUPABASE_KEY=

PORT=3000
